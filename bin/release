#!/usr/bin/env ruby
# frozen_string_literal: true

# Releases the leaves due by a date (UTC) into a new site directory.
#
#   AGE_SECRET_KEY=... bin/release <queue-dir> <out-dir> [--date YYYY-MM-DD] [--base-url URL]
#   bin/release spec/fixtures/queue <out-dir> --identity spec/fixtures/fixture-identity.txt
#
# The private key comes from the AGE_SECRET_KEY environment variable (an Actions
# secret) or, for local work with the fixture key, from --identity FILE.
# It is never printed.

require 'date'
require 'optparse'
require_relative '../lib/sweepers/queue'
require_relative '../lib/sweepers/release'

root = File.expand_path('..', __dir__)
options = { date: Time.now.utc.to_date, base_url: Sweepers::Release::DEFAULT_BASE_URL }
parser = OptionParser.new do |o|
  o.banner = 'Usage: bin/release <queue-dir> <out-dir> [options]'
  o.on('--date DATE', 'Release date, YYYY-MM-DD (default: today in UTC)') { |v| options[:date] = Date.iso8601(v) }
  o.on('--base-url URL', 'Absolute site URL for the sitemap') { |v| options[:base_url] = v }
  o.on('--identity FILE', 'age identity file (local/fixture use only)') { |v| options[:identity_file] = v }
end
queue_dir, out_dir = parser.parse!(ARGV)
abort(parser.help) unless queue_dir && out_dir

identity = options[:identity_file] ? File.read(options[:identity_file]) : ENV.fetch('AGE_SECRET_KEY', '')

begin
  leaves = Sweepers::Queue.load(queue_dir, identity)
  release = Sweepers::Release.new(leaves, date: options[:date], base_url: options[:base_url])
  release.write(out_dir, site_dir: File.join(root, 'site'), data_dir: File.join(root, 'data'),
                         shells_dir: File.join(root, 'shells'))
rescue Sweepers::Crypto::Error, Sweepers::Release::InvalidLeaf, ArgumentError => e
  abort("release failed: #{e.message}")
end

puts "Released #{options[:date]} (day #{Sweepers::Calendar.day_of_year(options[:date])}) to #{out_dir}: " \
     "#{leaves.size} days queued, #{release.released_leaves.size} leaves released, #{release.selections.size} selections"

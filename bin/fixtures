#!/usr/bin/env ruby
# frozen_string_literal: true

# Regenerates the encrypted fixture queue in spec/fixtures/queue/: only the
# leaves the specs need, around the parity date 2026-11-12 (day 317).
#
#   bin/fixtures
#
# - The leaves the live site showed on 2026-11-12 (today, yesterday and the 7
#   selections) come from the parity snapshot (spec/fixtures/parity-leaves.json)
#   and were already public. The 7 selections score 9 or 10.
# - A few synthetic leaves ("Fixture leaf for ...") test the release's rules on
#   that date: see SYNTHETIC below.
# - Every other day has no leaf, as a day the editor never published, so the
#   site shows its empty-day line there.
#
# A release for 2026-11-12 reproduces the live site's selections exactly.
#
# Every file is encrypted to the fixture recipient. The fixture identity is
# committed on purpose: it protects nothing and lets anyone run a release.

require 'fileutils'
require 'json'
require 'time'
require_relative '../lib/sweepers/calendar'
require_relative '../lib/sweepers/queue'

root = File.expand_path('..', __dir__)
fixtures = File.join(root, 'spec', 'fixtures')
queue_dir = File.join(fixtures, 'queue')

def leaf(day, html:, score:)
  { 'version' => 1, 'aphorism_id' => 9000 + day, 'draft_id' => 9000 + day, 'day_of_year' => day,
    'html' => html, 'snippet' => nil, 'score' => score, 'published_at' => '2019-01-01T12:00:00Z' }
end

# Synthetic leaves by day, with their scores, and what each one tests on 2026-11-12.
SYNTHETIC = {
  200 => 10, # 18 July: the best score, but outside the 90-day window, so never a selection
  300 => 8,  # 26 October: meets the threshold, but the 7 parity selections outrank it
  310 => 7,  # 5 November: inside the window, below the threshold of 8
  315 => 5,  # 10 November: the day before yesterday, which the release also writes
  318 => 10  # 13 November: after the release date, so never released
}.freeze

leaves = SYNTHETIC.to_h do |day, score|
  label = Sweepers::Calendar.canonical_date(day).strftime('%-d %B')
  [day, leaf(day, score: score, html: "<p>Fixture leaf for #{label} (day #{day}).</p>\n")]
end
JSON.parse(File.read(File.join(fixtures, 'parity-leaves.json')))['leaves'].each do |p|
  leaves[p['day_of_year']] = leaf(p['day_of_year'], html: p['html'], score: p['score'])
end

FileUtils.rm_rf(queue_dir)
FileUtils.mkdir_p(queue_dir)
recipients = File.join(fixtures, 'fixture-recipient.txt')
leaves.each_value { |l| Sweepers::Queue.write(l, queue_dir, recipients) }
puts "Wrote #{leaves.size} leaves to spec/fixtures/queue/"

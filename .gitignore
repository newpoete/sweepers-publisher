# Secrets: age identities (private keys). The fixture identity under
# spec/fixtures/ is the one exception and is added explicitly.
*.key
*.age-key
age-key.txt
key.txt
identity.txt
age-identity*.txt
# Deploy keys (Epic 3: the editor pushes with one; it never belongs in a repo)
deploy_key*
id_ed25519*
id_rsa*
.env
.env.*

# Decrypted queues: only the encrypted *.age form is ever committed.
queue.json
*.decrypted.json
*.plain.json
# Flask Datastore exports (Epic 3): every leaf, future ones included. Kept in ~/archives.
*datastore*.json*

# Local release output (the Action builds it; never commit it).
_site/
release-out/
tmp/

# Editors and OS
*~
.DS_Store
.vscode/
.idea/

# Bundler (local installs)
.bundle/
vendor/bundle/
